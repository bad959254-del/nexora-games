
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap');

:root {
  --bg: #080808;
  --panel: #141414;
  --gold: #e7b94f;
  --text: #f5f5f5;
  --muted: #999;
  --border: #292929;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'Inter', sans-serif;
  min-height: 100vh;
}

.header {
  height: 70px;
  padding: 0 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border);
  background: #0b0b0b;
}

.logo {
  font: 800 20px 'Orbitron', sans-serif;
  color: white;
  text-decoration: none;
  letter-spacing: 1px;
}

.logo span, .hero h1 span { color: var(--gold); }

.header-tag, .section-heading > span {
  color: var(--gold);
  font-size: 10px;
  letter-spacing: 2px;
  font-weight: 700;
}

.container {
  width: min(1100px, 90%);
  margin: auto;
}

.hero {
  padding: 95px 15px 100px;
  text-align: center;
  background: radial-gradient(ellipse at 50% 20%, #382a102e, transparent 65%);
}

.eyebrow {
  color: var(--gold);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 3px;
  margin-bottom: 18px;
}

.hero h1 {
  font: 800 clamp(36px, 7vw, 68px)/1.2 'Orbitron', sans-serif;
  letter-spacing: -2px;
  margin-bottom: 20px;
}

.hero > p:not(.eyebrow) {
  color: var(--muted);
  font-size: 15px;
  margin-bottom: 30px;
}

.hero-button {
  display: inline-block;
  padding: 15px 26px;
  background: var(--gold);
  color: #111;
  border-radius: 5px;
  text-decoration: none;
  font-weight: 800;
  font-size: 12px;
  letter-spacing: 1px;
  transition: .2s;
}

.hero-button:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 30px #e7b94f44;
}

.games-section { padding: 25px 0 85px; }

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 25px;
}

.section-heading h2 {
  font: 700 27px 'Orbitron', sans-serif;
}

.search {
  width: 100%;
  padding: 16px 18px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 7px;
  color: white;
  font-size: 14px;
  outline: none;
  margin-bottom: 25px;
}

.search:focus { border-color: var(--gold); }

.game-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 17px;
}

.game-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 22px 15px;
  text-align: center;
  text-decoration: none;
  color: white;
  transition: .25s;
  min-height: 155px;
}

.game-card:hover {
  transform: translateY(-5px);
  border-color: var(--gold);
  box-shadow: 0 8px 28px #e7b94f17;
}

.game-icon { font-size: 36px; margin-bottom: 13px; }

.game-card h3 {
  font-size: 14px;
  margin-bottom: 7px;
}

.game-card p {
  font-size: 11px;
  color: var(--muted);
  line-height: 1.5;
}

.empty-message {
  color: var(--muted);
  text-align: center;
  grid-column: 1 / -1;
  padding: 35px;
}

footer {
  padding: 35px 15px;
  text-align: center;
  border-top: 1px solid var(--border);
}

footer p {
  color: var(--muted);
  font-size: 12px;
  margin: 12px 0;
}

footer small { color: #666; font-size: 11px; }

@media (max-width: 750px) {
  .game-grid { grid-template-columns: repeat(2, 1fr); }
  .hero { padding: 75px 10px; }
  .header { padding: 0 5%; }
}

@media (max-width: 360px) {
  .game-grid { gap: 10px; }
  .game-card { padding: 17px 9px; }
  .header-tag { font-size: 8px; }
}
